{
  "name": "gkd-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --cache --write --ignore-unknown .",
    "dev": "pnpm build:api && pnpm -F @gkd-kit/docs docs:dev",
    "build:api": "pnpm -F @gkd-kit/api docs:build",
    "build": "pnpm build:api && pnpm -F @gkd-kit/docs docs:build",
    "preview": "pnpm -F @gkd-kit/docs docs:preview"
  },
  "dependencies": {
    "@gkd-kit/selector": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/file-saver": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vueuse/core": "catalog:",
    "acorn-walk": "catalog:",
    "cross-env": "catalog:",
    "file-saver": "catalog:",
    "jsdom": "catalog:",
    "magic-string": "catalog:",
    "markdown-it-mathjax3": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-data": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  }
}
