{
  "name": "gkd-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --cache --write --ignore-unknown .",
    "dev": "pnpm build:api && pnpm -F @gkd-kit/docs docs:dev",
    "build:api": "pnpm -F @gkd-kit/api docs:build",
    "build": "pnpm build:api && pnpm -F @gkd-kit/docs docs:build",
    "preview": "pnpm -F @gkd-kit/docs docs:preview"
  },
  "dependencies": {
    "@gkd-kit/selector": "^0.5.23",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vueuse/core": "^14.4.0",
    "acorn-walk": "^8.3.5",
    "cross-env": "^10.1.0",
    "file-saver": "^2.0.5",
    "jsdom": "^30.0.1",
    "magic-string": "^1.2.3",
    "markdown-it-mathjax3": "^4.3.2",
    "prettier": "^3.9.6",
    "terser": "^5.51.2",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "unocss": "^66.8.1",
    "unplugin-data": "^0.2.0",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.19"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  }
}
